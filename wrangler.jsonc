{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gi-online",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gi-openhouse",
      "database_id": "07866578-6593-4e16-9443-a07906320d90",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
